<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="澄波"
            android:textColor="@color/widget_on_background"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="点此打开"
            android:textColor="@color/widget_on_background"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_resume"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="继续收听"
        android:gravity="center"
        android:text="续"
        android:textColor="@color/widget_on_background"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="播放或暂停"
        android:padding="8dp"
        android:src="@drawable/ic_widget_play" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="下一台"
        android:padding="8dp"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
